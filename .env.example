# Copy this file to .env and update the values for your environment.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_NAME and DATABASE_URL empty to use SQLite locally.
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional one-time hosted admin bootstrap. Keep these values private.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# Optional: load demo accounts during the Render build (see README).
# DEMO_PASSWORD=

# Optional SMTP settings for password-reset emails. Without EMAIL_HOST,
# emails are printed to the server log instead of being sent.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=BizBridge <no-reply@example.com>
